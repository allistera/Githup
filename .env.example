# Copy to .env and fill in your own values. .env is gitignored; this file
# is committed as a template only. github_update/cli.py loads .env
# automatically on startup (python-dotenv), so every worker's `claude`
# subprocess inherits these vars.

# 1. Enable telemetry
export CLAUDE_CODE_ENABLE_TELEMETRY=1

# 2. Choose exporters (both are optional - configure only what you need)
export OTEL_METRICS_EXPORTER=otlp       # Options: otlp, prometheus, console, none
export OTEL_LOGS_EXPORTER=otlp          # Options: otlp, console, none

# 3. Configure OTLP endpoint (for OTLP exporter)
# NOTE: for a plaintext/local collector, use an explicit http:// scheme
# (e.g. http://collector-host:4317) - a bare host:port defaults to TLS,
# which fails against a bare IP with "TLS ServerName ... not permitted".
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc  # Options: grpc, http/json, http/protobuf
export OTEL_EXPORTER_OTLP_ENDPOINT=http://your-collector-host:4317

# 4. Set authentication (if required)
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer your-token-here"

# 5. For debugging: reduce export intervals
export OTEL_METRIC_EXPORT_INTERVAL=10000  # 10 seconds (default: 60000ms)
export OTEL_LOGS_EXPORT_INTERVAL=5000     # 5 seconds (default: 5000ms)

# 6. Structured log content (all off by default to avoid leaking prompt/response text)
export OTEL_LOG_TOOL_DETAILS=1            # include tool names/params (git, gh, edits) in logs
# export OTEL_LOG_USER_PROMPTS=1          # uncomment to also log raw prompt text
# export OTEL_LOG_ASSISTANT_RESPONSES=1   # uncomment to also log raw response text

# 7. Tag every log/metric with a service name so github-update is distinguishable
#    from other Claude Code usage in SigNoz. worker.py adds a per-repo `repo=`
#    attribute on top of this for each worker, so concurrent workers are
#    individually filterable/attributable in the backend.
export OTEL_RESOURCE_ATTRIBUTES=service.name=github-update
